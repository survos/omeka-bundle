{
    "name": "survos/omeka-bundle",
    "description": "Symfony HttpClient wrapper for the Omeka-S REST API",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "symfony",
        "omeka",
        "omeka-s",
        "api",
        "museum",
        "archive",
        "digital-humanities"
    ],
    "authors": [
        {
            "name": "Tac Tacelosky",
            "email": "tacman@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "survos/core-bundle": "^2.5",
        "survos/jsonl-bundle": "^2.5",
        "symfony/cache": "^8.1",
        "symfony/config": "^8.1",
        "symfony/console": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/event-dispatcher": "^8.1",
        "symfony/http-client": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/messenger": "^8.1",
        "symfony/mime": "^8.1",
        "survos/data-contracts": "^2.5"
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest",
        "phpunit/phpunit": "^13.0",
        "symfony/var-dumper": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Survos\\OmekaBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Survos\\OmekaBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "require": "^8.0"
        }
    }
}